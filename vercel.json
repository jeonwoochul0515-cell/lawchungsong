{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.chang-hee.kim" }],
      "destination": "https://chang-hee.kim/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.chang-hee.kim" }],
      "destination": "https://chang-hee.kim/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
